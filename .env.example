# Port for the API (and the built UI in production)
PORT=8787
# Display name in the sidebar / manifest
DASHBOARD_NAME=Agent Dashboard
# Protect the API + UI with a key (recommended once deployed)
# DASHBOARD_API_KEY=change-me
# Needed for agents that use the "Claude" runner
# ANTHROPIC_API_KEY=sk-ant-...
# Allow the "Local command / script" runner (executes commands on this server)
# ALLOW_COMMAND_RUNNER=true
# Where data is stored (JSON file)
# DATA_DIR=data
# Which origins may call the API from a browser (comma-separated, * = any)
# CORS_ORIGINS=*
# Which sites may embed this dashboard in an iframe (CSP frame-ancestors)
# FRAME_ANCESTORS='self' https://my-other-dashboard.example.com
# Set to false to skip the demo agents + history on first launch
# SEED_DEMO=true

# ---- Construction intelligence platform (Advanced Landscape 2000) ----
# Extra API keys with narrower roles (owner = DASHBOARD_API_KEY). Staff can
# edit projects, contacts and drafts; viewers can only read non-sensitive data.
# DASHBOARD_STAFF_KEY=staff-key
# DASHBOARD_VIEWER_KEY=viewer-key
# Key used to encrypt uploaded company documents (AES-256-GCM). If unset, a
# key is generated once and stored in DATA_DIR/documents/.key. Keep a backup:
# files cannot be opened without it.
# DOCUMENT_ENCRYPTION_KEY=a-long-random-phrase
# Only needed when the server must reach the internet through an HTTPS proxy
# (Node's fetch ignores HTTPS_PROXY unless this is set).
# NODE_USE_ENV_PROXY=1

# ---- Vercel + Supabase (production) ----
# Added automatically when Supabase is connected under Vercel → Storage:
# POSTGRES_URL=postgres://...
# Lets only Vercel Cron start the daily automations (Vercel sends it as a Bearer token):
# CRON_SECRET=a-long-random-phrase
# Set to true to also seed the AI-agent demo history on Vercel (large; off by default):
# SEED_AGENT_DEMO=false
